#!/usr/bin/env bash
# check: model-check MainActivity's use of the Pleos Vehicle SDK with TLC.
# What each line of output means is in SKILL.md next to this file.
set -euo pipefail

TLA_VERSION=1.7.4
TLA_URL=https://github.com/tlaplus/tlaplus/releases/download/v$TLA_VERSION/tla2tools.jar
TLA_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
JAR=${TLA2TOOLS_JAR:-$HOME/.cache/tlaplus/tla2tools-$TLA_VERSION.jar}

HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(git -C "$HERE" rev-parse --show-toplevel)
MODEL=$HERE/model
SYNC=$HERE/sync.txt
ACTIVITY=app/src/main/java/com/gomsoo/saigil/MainActivity.kt
VERSIONS=gradle/libs.versions.toml
LOGS=$REPO/build/formal-verify-vehicle-lifecycle

# config, then PASS or the finding and the property that is expected to break.
EXPECTATIONS="
healthy PASS
late PASS
dies PASS
late-stranded F1 NoStrandedRequest
late-unbind F2 ReleaseUnbinds
dies-stranded F3 NoStrandedRequest
"

# broken variant, then the property of healthy.cfg that must catch it.
MUTANTS="
release-in-oncreate NoStrandedRequest
request-before-initialize NoSelfInflictedFailure
no-release ReleaseUnbindsOnceBound
"

die() { echo "check: $*" >&2; exit 1; }

# What the model was last confirmed against.
covered_now() {
    echo "activity $(shasum -a 256 "$REPO/$ACTIVITY" | cut -d' ' -f1)"
    echo "sdk $(sed -n 's/^pleosVehicle *= *"\(.*\)"/\1/p' "$REPO/$VERSIONS")"
}

# Runs TLC on a private copy of the model so its trace files stay out of the repo.
# Prints PASS, "VIOLATED <property>" or "ERROR <exit code>". The full output goes to $LOGS.
run_tlc() {
    local config=$1 calls=$2 log=$3 run code=0
    run=$(mktemp -d)
    cp "$MODEL/VehicleLifecycle.tla" "$MODEL/$config.cfg" "$run/"
    cp "$calls" "$run/MainActivityCalls.tla"
    (cd "$run" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
        -config "$config.cfg" VehicleLifecycle.tla) >"$log" 2>&1 || code=$?
    rm -rf "$run"
    case $code in
    0) echo PASS ;;
    12) echo "VIOLATED $(sed -n 's/^Error: Invariant \(.*\) is violated.*/\1/p' "$log" | head -1)" ;;
    13) echo "VIOLATED ScreenLeavesLoading" ;;
    *) echo "ERROR $code" ;;
    esac
}

[ -f "$JAR" ] || die "TLC is missing. Get it with:
  mkdir -p $(dirname "$JAR") && curl -fsSL -o $JAR $TLA_URL
or point TLA2TOOLS_JAR at a tla2tools.jar you already have."
command -v java >/dev/null || die "java is not on PATH"
# A jar named through TLA2TOOLS_JAR is the caller's choice and is not checked.
if [ -z "${TLA2TOOLS_JAR:-}" ] && [ "$(shasum -a 256 "$JAR" | cut -d' ' -f1)" != "$TLA_SHA256" ]; then
    die "$JAR is not the tla2tools.jar of release v$TLA_VERSION; delete it and download again"
fi
mkdir -p "$LOGS"

case ${1:-} in
"")
    status=0
    while read -r config expect property; do
        [ -n "$config" ] || continue
        log=$LOGS/$config.out
        outcome=$(run_tlc "$config" "$MODEL/MainActivityCalls.tla" "$log")
        if [ "$expect" = PASS ] && [ "$outcome" = PASS ]; then
            printf 'ok       %-14s holds\n' "$config"
        elif [ "$expect" != PASS ] && [ "$outcome" = "VIOLATED $property" ]; then
            printf 'ok       %-14s known finding %s still breaks %s\n' "$config" "$expect" "$property"
        elif [ "$expect" != PASS ] && [ "$outcome" = PASS ]; then
            printf 'CHANGED  %-14s finding %s no longer breaks %s\n' "$config" "$expect" "$property"
            [ "$status" -ne 0 ] || status=2
        else
            printf 'BROKEN   %-14s %s, trace in %s\n' "$config" "$outcome" "$log"
            status=1
        fi
    done <<<"$EXPECTATIONS"
    if [ "$(covered_now)" != "$(grep -v '^commit ' "$SYNC")" ]; then
        echo "STALE    $ACTIVITY or the SDK version changed since the model was last confirmed (sync.txt)"
        [ "$status" -ne 0 ] || status=3
    fi
    exit $status
    ;;
--self-test)
    status=0
    while read -r mutant property; do
        [ -n "$mutant" ] || continue
        log=$LOGS/mutant-$mutant.out
        outcome=$(run_tlc healthy "$MODEL/mutants/$mutant/MainActivityCalls.tla" "$log")
        if [ "$outcome" = "VIOLATED $property" ]; then
            printf 'ok       %-26s caught by %s\n' "$mutant" "$property"
        else
            printf 'MISSED   %-26s wanted %s, got %s, see %s\n' "$mutant" "$property" "$outcome" "$log"
            status=1
        fi
    done <<<"$MUTANTS"
    exit $status
    ;;
--resync)
    {
        covered_now
        echo "commit $(git -C "$REPO" rev-parse --short HEAD)"
    } >"$SYNC"
    cat "$SYNC"
    ;;
*)
    die "usage: check [--self-test | --resync]"
    ;;
esac
